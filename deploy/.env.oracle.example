# Copie para a RAIZ do repo como .env e troque TODAS as senhas.
#   cp deploy/.env.oracle.example .env

APP_NAME="Leads CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://TROQUE-pelo-IP-ou-dominio

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Banco — container 'mysql' do deploy/compose.oracle.yml
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=leads
DB_USERNAME=leads
DB_PASSWORD=TROQUE-esta-senha
DB_ROOT_PASSWORD=TROQUE-esta-senha-root

# Sem Redis no free tier
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Admin do painel (/admin) — criado pelo seeder (DatabaseSeeder)
ADMIN_NAME="Seu Nome"
ADMIN_EMAIL=voce@seudominio.com
ADMIN_PASSWORD=TROQUE-por-uma-senha-forte

MAIL_MAILER=log
